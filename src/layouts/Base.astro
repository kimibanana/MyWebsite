---
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  noindex?: boolean;
  ogImage?: string;
}
const { title, description, schema = [], noindex = false, ogImage = '/og-image.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/favicon.svg`,
  image: `${site.url}/og-image.png`,
  description: site.description,
  ...(site.email ? { email: site.email } : {}),
  founder: { '@type': 'Person', name: site.founder.name, jobTitle: site.founder.role },
  telephone: site.whatsappDisplay,
  priceRange: '$$',
  areaServed: site.markets.map((name) => ({ '@type': 'Country', name })),
  knowsAbout: ['Medical marketing', 'Healthcare SEO', 'Local SEO', 'Medical website design', 'Google Ads', 'Local Services Ads', 'Website maintenance'],
  sameAs: site.socialLive ? site.social.map((s) => s.url) : [],
};
const allSchema = [orgSchema, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0E7C7B" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>
      // Apply the saved or system theme before first paint to avoid a flash.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        // Currency: saved choice, else guess from the visitor's time zone.
        var c = null;
        try { c = localStorage.getItem('currency'); } catch (e) {}
        if (!/^(USD|PHP|GBP|AUD)$/.test(c || '')) {
          var tz = '';
          try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
          c = tz === 'Asia/Manila' ? 'PHP'
            : /^Europe\/(London|Belfast|Guernsey|Jersey|Isle_of_Man)$/.test(tz) ? 'GBP'
            : /^Australia\//.test(tz) ? 'AUD' : 'USD';
        }
        d.dataset.currency = c;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <TopBar />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      // Show every price in the chosen currency and keep all selectors in sync.
      const root = document.documentElement;
      const applyCurrency = (code: string) => {
        root.dataset.currency = code;
        const key = code.toLowerCase();
        document.querySelectorAll<HTMLElement>('.price').forEach((el) => {
          const v = el.dataset[key];
          if (v) el.textContent = v;
        });
        document.querySelectorAll<HTMLSelectElement>('.cur__select').forEach((s) => (s.value = code));
        root.classList.add('prices-ready');
      };
      document.querySelectorAll<HTMLSelectElement>('.cur__select').forEach((s) =>
        s.addEventListener('change', () => {
          try { localStorage.setItem('currency', s.value); } catch {}
          applyCurrency(s.value);
        }),
      );
      applyCurrency(root.dataset.currency || 'USD');
    </script>
    <script>
      // Minimal scroll reveal. Respects reduced motion via CSS.
      const items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
