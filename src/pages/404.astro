---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Web Frontier" description="This page could not be found." noindex>
  <section class="section">
    <div class="wrap" style="text-align:center">
      <span class="eyebrow">404</span>
      <h1>This page went missing</h1>
      <p class="lead" style="margin:0 auto 28px">Ironically, this is the kind of thing we fix for clients. Let’s get you back on track.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/">Go to homepage</a>
        <a class="btn btn--secondary" href="/services">Browse services</a>
      </div>
    </div>
  </section>
</Base>
