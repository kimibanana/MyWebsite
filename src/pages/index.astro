---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import SprintCycle from '../components/SprintCycle.astro';
import { homeFaqs, pains, process, promises, industries } from '../data/content';

const stats = site.stats.filter((s) => s.value);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const compare = [
  ['Open-ended retainer, scope unclear', 'Fixed-scope 30-day sprints, written down'],
  ['Vague monthly “activity” reports', 'Every deliverable listed, plus calls and leads'],
  ['6–12 month lock-in contracts', 'Month-to-month. Pause or swap sprints anytime'],
  ['Agency owns your site and accounts', 'Everything registered in your name'],
  ['Shared leads sold to your competitors', 'Exclusive leads from your own site and profile'],
];
---
<Base
  title="Local SEO, Web Design & Google Ads for Service Businesses | Web Frontier"
  description={site.description}
  schema={[faqSchema]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__copy">
        <span class="eyebrow">For local businesses in the US, UK, Canada & Australia</span>
        <h1>More calls and booked jobs from Google, <span class="hl">one 30‑day sprint at a time</span></h1>
        <p class="lead">Web Frontier gets local service businesses into the Map Pack, onto page one and in front of buyers with Local SEO, websites, Google Ads and Local Services Ads. No vague retainers: every sprint has a fixed scope, price and delivery date.</p>
        <ul class="hero__points">
          <li><Icon name="check" />Free growth audit with your 3 biggest fixes</li>
          <li><Icon name="check" />Fixed-price sprints, no long contracts</li>
          <li><Icon name="check" />You own your site and accounts</li>
        </ul>
        <div class="btn-row hero__ctas">
          <a class="btn btn--primary" href="#hero-form">Get my free growth audit <Icon name="arrow" /></a>
          <a class="btn btn--secondary" href="/pricing">See how sprints work</a>
        </div>
        {stats.length > 0 && (
          <dl class="hero__stats">
            {stats.map((s) => <div><dt>{s.value}</dt><dd>{s.label}</dd></div>)}
          </dl>
        )}
      </div>
      <div class="hero__form" id="hero-form">
        <LeadForm id="hero" title="Get your free growth audit" compact />
      </div>
    </div>
  </section>

  <section class="strip" aria-label="Industries we work with">
    <div class="wrap strip__in">
      <span>Built for local service businesses</span>
      <ul>{industries.map((p) => <li>{p}</li>)}</ul>
    </div>
  </section>

  <!-- Pain points -->
  <section class="section">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">Sound familiar?</span>
        <h2>Your competitors are getting the calls you should be getting</h2>
        <p class="lead">Most local business owners we talk to are dealing with at least one of these.</p>
      </div>
      <div class="grid grid-4">
        {pains.map((p) => (
          <div class="card pain reveal">
            <div class="icon-badge icon-badge--warn"><Icon name={p.icon} /></div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <p class="bridge reveal">The good news: every one of these is fixable. <a href="#services">Here’s how we help <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--surface" id="services">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">What we do</span>
        <h2>Everything you need to win your local market</h2>
        <p class="lead">Start with one service or stack them. Every sprint is built around one goal: more calls, booked jobs and revenue.</p>
      </div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a href={`/services/${s.slug}`} class="card svc reveal">
            <div class="icon-badge"><Icon name={s.icon} /></div>
            <h3>{s.name}</h3>
            <p>{s.short}</p>
            <span class="svc__foot"><span>From <strong>{s.startingAt}</strong></span><span class="svc__more">Learn more <Icon name="arrow" /></span></span>
          </a>
        ))}
        <a href="/free-audit" class="card svc svc--cta reveal">
          <h3>Not sure where to start?</h3>
          <p>Tell us about your business and market, and we’ll recommend the right sprints for free.</p>
          <span class="svc__more">Get a free growth audit <Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section section--night">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Why Web Frontier</span>
        <h2>The marketing partner you wished you hired the first time</h2>
        <p class="lead">Too many local business owners have paid agencies for months without knowing what they got. We built Web Frontier around sprints so you always see the plan, the work and the results.</p>
      </div>
      <div class="grid grid-4 promises">
        {promises.map((p) => (
          <div class="promise reveal">
            <div class="icon-badge icon-badge--night"><Icon name={p.icon} /></div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <div class="compare reveal" role="table" aria-label="Typical agency compared with Web Frontier">
        <div class="compare__row compare__row--head" role="row">
          <span role="columnheader">Typical agency</span><span role="columnheader">Web Frontier</span>
        </div>
        {compare.map(([them, us]) => (
          <div class="compare__row" role="row">
            <span role="cell" class="compare__them"><Icon name="close" />{them}</span>
            <span role="cell" class="compare__us"><Icon name="check" />{us}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">How it works</span>
        <h2>From free audit to more booked jobs in 4 steps</h2>
      </div>
      <ol class="steps">
        {process.map((p, i) => (
          <li class="step reveal">
            <span class="step__num">{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>
      <div class="center"><a class="btn btn--primary" href="/free-audit">Start with step 1, it’s free <Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- Proof -->
  <section class="section section--surface">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Results</span>
        <h2>Local businesses, measurable growth</h2>
        <p class="lead">We measure success by calls, booked jobs and revenue, not just rankings.</p>
      </div>
      <CaseStudies />
      <div class="center"><a class="btn btn--secondary" href="/work">See more results <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">Client reviews</span>
        <h2>What our clients say</h2>
      </div>
      <Testimonials />
    </div>
  </section>

  <!-- Sprints -->
  <section class="section section--surface">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">How sprints work</span>
        <h2>No retainers that disappear into a black box</h2>
        <p class="lead">Work happens in 30-day sprints with a written scope and fixed price. You see the plan before you pay and the deliverables after.</p>
      </div>
      <SprintCycle />
      <div class="grid grid-3 teasers">
        <a class="card teaser reveal" href="/pricing#seo"><span>Foundation Sprint</span><strong>$997</strong><small>one-time, 30 days</small></a>
        <a class="card teaser teaser--featured reveal" href="/pricing#bundles"><span>Monthly SEO sprints</span><strong>from $650</strong><small>per month, no contract</small></a>
        <a class="card teaser reveal" href="/pricing#websites"><span>Website Launch Sprint</span><strong>from $2,500</strong><small>one-time, live in ~30 days</small></a>
      </div>
      <div class="center"><a class="btn btn--secondary" href="/pricing">See all sprints & pricing <Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">FAQ</span>
        <h2>Questions we hear every week</h2>
      </div>
      <Faq items={homeFaqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { padding: clamp(40px, 6vw, 80px) 0 clamp(48px, 7vw, 96px); background:
    radial-gradient(60% 80% at 100% 0%, var(--brand-tint) 0%, transparent 70%),
    linear-gradient(180deg, #fff 0%, var(--surface) 100%); }
  .hero__in { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .hero h1 .hl { color: var(--brand); }
  .hero__points { list-style: none; padding: 0; margin: 24px 0 30px; display: grid; gap: 10px; }
  .hero__points li { display: flex; gap: 10px; align-items: center; font-weight: 500; color: var(--ink); }
  .hero__points :global(svg) { width: 20px; height: 20px; color: var(--success); flex: none; }
  .hero__stats { display: flex; flex-wrap: wrap; gap: 32px; margin: 36px 0 0; }
  .hero__stats dt { font-family: var(--font-display); font-size: 1.9rem; font-weight: 800; color: var(--ink); }
  .hero__stats dd { margin: 0; font-size: 0.88rem; color: var(--muted); }
  .hero__form { scroll-margin-top: 96px; }
  @media (max-width: 960px) {
    .hero__in { grid-template-columns: 1fr; }
    .hero__ctas .btn--primary { display: none; }
  }

  .strip { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: #fff; }
  .strip__in { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding-top: 20px; padding-bottom: 20px; }
  .strip span { font-size: 0.82rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .strip ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 26px; margin: 0; padding: 0; }
  .strip li { font-family: var(--font-display); font-weight: 700; color: #8291a5; font-size: 1.02rem; }

  .icon-badge--warn { background: #fff1e6; color: #c2570c; }
  .bridge { text-align: center; margin: 40px 0 0; font-size: 1.12rem; color: var(--ink); font-weight: 600; }
  .bridge a { display: inline-flex; align-items: center; gap: 6px; }
  .bridge :global(svg) { width: 18px; height: 18px; }

  .svc { text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: border-color .15s ease, box-shadow .15s ease; }
  .svc:hover { border-color: var(--brand); box-shadow: var(--shadow); color: inherit; }
  .svc p { flex: 1; }
  .svc__foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 0.92rem; }
  .svc__foot strong { color: var(--ink); }
  .svc__more { display: inline-flex; align-items: center; gap: 6px; color: var(--brand); font-weight: 700; font-size: 0.92rem; }
  .svc__more :global(svg) { width: 16px; height: 16px; }
  .svc--cta { background: var(--brand); border-color: var(--brand); color: #e6f4f3; justify-content: center; }
  .svc--cta h3 { color: #fff; }
  .svc--cta .svc__more { color: #fff; }
  .svc--cta:hover { color: #e6f4f3; background: var(--brand-dark); }

  .promise h3 { color: #fff; font-size: 1.12rem; }
  .promise p { font-size: 0.97rem; }
  .icon-badge--night { background: rgb(95 211 207 / 0.12); color: #5fd3cf; }
  .compare { margin-top: 56px; border: 1px solid rgb(255 255 255 / 0.1); border-radius: var(--radius-lg); overflow: hidden; }
  .compare__row { display: grid; grid-template-columns: 1fr 1fr; }
  .compare__row > span { padding: 16px 22px; display: flex; gap: 10px; align-items: flex-start; border-top: 1px solid rgb(255 255 255 / 0.08); }
  .compare__row--head > span { border-top: 0; font-family: var(--font-display); font-weight: 700; color: #fff; background: var(--night-2); }
  .compare__us { background: rgb(14 124 123 / 0.14); color: #e6f4f3; font-weight: 500; }
  .compare__row :global(svg) { width: 18px; height: 18px; flex: none; margin-top: 4px; }
  .compare__them :global(svg) { color: #f87171; }
  .compare__us :global(svg) { color: #5fd3cf; }
  @media (max-width: 640px) { .compare__row > span { padding: 14px; font-size: 0.92rem; } }

  .steps { list-style: none; padding: 0; margin: 0 0 48px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; counter-reset: s; }
  .step { position: relative; padding-top: 8px; }
  .step__num { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--ink); color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 1.1rem; margin-bottom: 18px; }
  .step:first-child .step__num { background: var(--accent); color: var(--ink); }
  @media (max-width: 960px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  .center { text-align: center; margin-top: 40px; }

  .teasers { margin-top: 24px; }
  .teaser { text-decoration: none; color: var(--muted); text-align: center; display: grid; gap: 4px; transition: border-color .15s ease; }
  .teaser:hover { border-color: var(--brand); color: var(--muted); }
  .teaser span { font-weight: 600; color: var(--ink); }
  .teaser strong { font-family: var(--font-display); font-size: 2rem; color: var(--ink); letter-spacing: -0.03em; }
  .teaser--featured { border: 2px solid var(--brand); }
</style>
