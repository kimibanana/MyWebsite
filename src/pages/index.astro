---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import Faq from '../components/Faq.astro';
import CaseStudies from '../components/CaseStudies.astro';
import SprintCycle from '../components/SprintCycle.astro';
import SprintScope from '../components/SprintScope.astro';
import { site } from '../data/site';
import { priceHtml } from '../lib/price';
import { homeFaqs, pains, framework, whyUs, consultation, promises } from '../data/content';

// The questions a buyer weighing an agency asks first: focus, where we work, how sprints work, compliance, contracts.
const faqs = [0, 2, 3, 5, 6].map((i) => homeFaqs[i]);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const builtFor = ['Clinics', 'Hospitals', 'Dental', 'Aesthetics', 'Allied health', 'Diagnostics', 'Fertility', 'Aged care'];
---
<Base
  title="Medical Marketing Agency for Clinics Worldwide | Healthcare SEO, Websites & Ads | Web Frontier"
  description={site.description}
  schema={[faqSchema]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__copy">
        <span class="eyebrow">Healthcare marketing for clinics worldwide</span>
        <h1>Helping more patients find the care they need</h1>
        <p class="lead">We help clinics and hospitals get found, trusted and booked online, so you can spend your time on patients, not marketing.</p>
        <div class="btn-row hero__ctas">
          <a class="btn btn--primary" href="#growth-audit">Get a free growth audit <Icon name="arrow" /></a>
          <a class="btn btn--secondary" href="/services">How we help</a>
        </div>
        <ul class="hero__points">
          <li><Icon name="file" />Fixed-price 30-day sprints</li>
          <li><Icon name="shield" />Every scoped item delivered, or we keep working free</li>
          <li><Icon name="unlock" />Month-to-month, no contracts</li>
        </ul>
      </div>
      <SprintScope />
    </div>
  </section>

  <section class="strip" aria-label="Who we help">
    <div class="wrap strip__in">
      <span>Built for</span>
      <ul>{builtFor.map((n) => <li>{n}</li>)}</ul>
    </div>
  </section>

  <!-- Empathy -->
  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">We understand</span>
        <h2>Your days are full of patients. Marketing shouldn’t add to the load.</h2>
        <p class="lead">Most clinics we meet are doing great work that patients simply can’t find. We fix that, calmly and clearly.</p>
      </div>
      <div class="grid grid-3">
        {pains.map((p) => (
          <div class="soft reveal">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How we help -->
  <section class="section section--surface">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">How we help</span>
        <h2>One simple path from search to booking</h2>
      </div>
      <ol class="path">
        {framework.map((f, i) => (
          <li class="reveal">
            <span class="path__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
            <a href={f.href} aria-label={`Learn more: ${f.title}`}>Learn more <Icon name="arrow" /></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Results -->
  <section class="section section--surface">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Example sprints</span>
        <h2>What a sprint plan can look like</h2>
        <p class="lead">Illustrative examples of how we scope work for different clinics. They are not client results; we’ll share real case studies as they come in.</p>
      </div>
      <CaseStudies illustrative />
      <div class="center"><a class="btn btn--secondary" href="/work">See more examples <Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">How we work</span>
        <h2>Fixed-price 30-day sprints</h2>
        <p class="lead" set:html={priceHtml('Start with a Foundation Sprint, then add monthly sprints from $650. Each one has a written scope and a set price before we start.')} />
      </div>
      <SprintCycle />
      <div class="promise reveal">
        <Icon name="shield" />
        <div>
          <h3>The sprint promise</h3>
          <p>If we don’t deliver every item in a sprint’s written scope by the end of the 30 days, we keep working on it at no extra cost until it’s done.</p>
          <ul class="promise__list">
            {promises.map((p) => <li><Icon name="check" />{p.title}</li>)}
          </ul>
        </div>
      </div>
      <div class="center"><a class="btn btn--secondary" href="/pricing">See pricing <Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- Founder and why us -->
  <section class="section section--surface">
    <div class="wrap founder">
      <div class="founder__photo" aria-hidden="true">{site.founder.initials}</div>
      <div class="reveal">
        <h2 class="founder__h">Specialists in healthcare, and only healthcare</h2>
        <!-- TODO: founder photo -->
        <blockquote>“Clinics do some of the most important work there is. We’re here to make sure the patients who need you can find you.”</blockquote>
        <p class="founder__sign"><strong>{site.founder.name}</strong> · {site.founder.role}, {site.experience} in SEO, web and paid search</p>
        <ul class="founder__why">
          {whyUs.filter((w) => w.icon !== 'file').map((w) => (
            <li><strong>{w.title}.</strong> {w.body}</li>
          ))}
        </ul>
        <a class="founder__link" href="/about">Meet the team <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--surface">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Questions</span>
        <h2>Good to know</h2>
      </div>
      <Faq items={faqs} />
      <p class="faq__more">More questions? <a href="/resources">Read our free guides for clinics <Icon name="arrow" /></a></p>
    </div>
  </section>

  <!-- Free audit -->
  <section class="section" id="growth-audit">
    <div class="wrap together">
      <div class="reveal">
        <span class="eyebrow">Free growth audit</span>
        <h2>Let’s see how patients find you today</h2>
        <p class="lead">A friendly review of your online presence, with the three changes that would help most. No obligation.</p>
        <ul class="benefits">
          {consultation.slice(0, 3).map((c) => (
            <li><Icon name="check" /><span>{c.title}</span></li>
          ))}
        </ul>
        <p class="together__note"><Icon name="whatsapp" />Prefer to chat? <a href={site.whatsapp} target="_blank" rel="noopener">Message us on WhatsApp</a></p>
      </div>
      <LeadForm id="home" title="Book your free growth audit" button="Book my free audit" compact />
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(40px, 6vw, 88px) 0 clamp(56px, 7vw, 104px); background: linear-gradient(180deg, var(--sage), var(--bg) 85%); }
  .hero__in { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(36px, 6vw, 80px); align-items: center; }
  .hero h1 { font-size: clamp(2.3rem, 5vw, 3.6rem); max-width: 14ch; }
  .hero .lead { max-width: 46ch; }
  .hero__ctas { margin: 30px 0 26px; }
  .hero__points { list-style: none; padding: 22px 0 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; border-top: 1px solid var(--line); }
  .hero__points li { display: inline-flex; gap: 8px; align-items: center; font-size: 0.95rem; font-weight: 500; color: var(--ink); }
  .hero__points :global(svg) { width: 16px; height: 16px; color: var(--brand-text); flex: none; }
  @media (max-width: 960px) { .hero__in { grid-template-columns: 1fr; } .hero h1 { max-width: none; } }

  .strip { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .strip__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 28px; padding-top: 22px; padding-bottom: 22px; }
  .strip span { font-size: 0.95rem; font-weight: 600; color: var(--ink); }
  .strip ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 26px; margin: 0; padding: 0; }
  .strip li { font-family: var(--font-display); font-weight: 600; color: var(--muted); }

  .soft { padding: 24px 0 0; border-top: 2px solid var(--brand); }
  .soft h3 { margin: 0 0 6px; }
  .soft p { color: var(--muted); margin: 0; max-width: 34ch; }

  .path { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; counter-reset: p; }
  @media (max-width: 960px) { .path { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .path { grid-template-columns: 1fr; } }
  .path li { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 28px 24px; display: flex; flex-direction: column; }
  .path__n { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; color: var(--brand-text); margin-bottom: 14px; font-variant-numeric: tabular-nums; }
  .path h3 { margin-bottom: 6px; }
  .path p { color: var(--muted); font-size: 0.98rem; flex: 1; }
  .path a { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.95rem; text-decoration: none; }
  .path a :global(svg) { width: 16px; height: 16px; }

  .center { text-align: center; margin-top: 44px; }

  .promise { margin-top: 24px; display: flex; gap: 20px; padding: clamp(22px, 3vw, 32px); border-radius: var(--radius-lg); background: var(--brand-tint); }
  .promise > :global(svg) { width: 40px; height: 40px; color: var(--brand-text); flex: none; }
  .promise h3 { margin-bottom: 6px; }
  .promise p { margin: 0; max-width: 62ch; color: var(--ink); }
  .promise__list { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .promise__list li { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--ink); font-size: 0.95rem; }
  .promise__list :global(svg) { width: 16px; height: 16px; color: var(--brand-text); flex: none; }
  @media (max-width: 520px) { .promise { flex-direction: column; gap: 14px; } }

  .founder { display: grid; grid-template-columns: 160px 1fr; gap: clamp(28px, 5vw, 56px); align-items: center; max-width: 900px; }
  .founder__photo { width: 160px; height: 160px; border-radius: var(--radius-lg); background: var(--ink); color: #fff; display: grid; place-items: center; font-family: var(--font-display); font-size: 3rem; font-weight: 700; }
  .founder blockquote { margin: 0 0 16px; font-family: var(--font-display); font-weight: 500; font-size: clamp(1.35rem, 2.6vw, 1.85rem); line-height: 1.4; color: var(--ink); }
  .founder__sign { color: var(--muted); margin: 0; }
  .founder__sign strong { color: var(--ink); }
  .founder__h { font-size: clamp(1.15rem, 1.8vw, 1.3rem); margin-bottom: 14px; color: var(--brand-text); }
  .founder__why { list-style: none; margin: 22px 0 0; padding: 20px 0 0; border-top: 1px solid var(--line); display: grid; gap: 10px; }
  .founder__why li { color: var(--muted); max-width: 62ch; }
  .founder__why strong { color: var(--ink); }
  .founder__link, .faq__more a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-weight: 600; text-decoration: none; }
  .founder__link { margin-top: 10px; }
  .founder__link :global(svg), .faq__more :global(svg) { width: 16px; height: 16px; }
  .faq__more { margin: 24px 0 0; color: var(--muted); text-align: center; }
  @media (max-width: 640px) { .founder { grid-template-columns: 1fr; } .founder__photo { width: 110px; height: 110px; font-size: 2rem; } }

  .together { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  @media (max-width: 960px) { .together { grid-template-columns: 1fr; } }
  #growth-audit { scroll-margin-top: 70px; }
  .benefits { list-style: none; padding: 0; margin: 24px 0; display: grid; gap: 12px; }
  .benefits li { display: flex; gap: 12px; align-items: center; color: var(--ink); font-weight: 500; }
  .benefits :global(svg) { width: 22px; height: 22px; padding: 4px; border-radius: 4px; background: var(--brand-tint); color: var(--brand-text); flex: none; }
  .together__note { display: flex; align-items: center; gap: 8px; color: var(--muted); }
  .together__note :global(svg) { width: 18px; height: 18px; color: var(--brand-text); }
</style>
