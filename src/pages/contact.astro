---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const channels = [
  { icon: 'whatsapp', label: 'WhatsApp (fastest)', value: site.whatsappDisplay, href: site.whatsapp, ext: true },
  ...(site.email ? [{ icon: 'mail', label: 'Email', value: site.email, href: `mailto:${site.email}` }] : []),
  { icon: 'calendar', label: 'Book a call', value: 'Pick a time in your time zone', href: site.bookingUrl },
];
---
<Base
  title="Contact Us | Web Frontier"
  description="Talk to Web Frontier about medical SEO, your clinic website or Google Ads. Message us on WhatsApp, email, or send the form. We reply within 1 business day."
>
  <PageHero
    eyebrow="Contact"
    title="Let’s grow your business together"
    lead="Send a message or reach us on WhatsApp. We reply within 1 business day in your time zone, usually much sooner."
    crumbs={[{ label: 'Contact' }]}
  />
  <section class="section">
    <div class="wrap contact">
      <div>
        <ul class="channels">
          {channels.map((c) => (
            <li>
              <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
                <span class="icon-badge"><Icon name={c.icon} /></span>
                <span><small>{c.label}</small><strong>{c.value}</strong></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="card info">
          <p><Icon name="clock" /><span><strong>Office hours</strong><br />{site.hours}</span></p>
          <p><Icon name="globe" /><span><strong>Where we work</strong><br />Based in the Philippines, working with clinics and practices across the country and in the {site.markets.filter((m) => m !== 'Philippines').join(', ').replace(/, ([^,]*)$/, ', and $1')}.</span></p>
        </div>
        <figure class="map">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(site.map.query)}&output=embed`}
            title={`Map of ${site.map.label}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <figcaption><Icon name="map" />Based in {site.map.label}, working remotely with clients worldwide.</figcaption>
        </figure>
      </div>
      <LeadForm id="contact" formName="contact" title="Send us a message" button="Send message" />
    </div>
  </section>
</Base>

<script>
  // Pre-select a plan when arriving from the pricing page (?plan=...).
  const plan = new URLSearchParams(location.search).get('plan');
  const msg = document.querySelector<HTMLTextAreaElement>('#contact-msg');
  if (plan && msg && !msg.value) msg.value = `I’m interested in the ${plan} plan.`;
</script>

<style>
  .contact { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
  .channels { list-style: none; padding: 0; margin: 0 0 20px; display: grid; gap: 12px; }
  .channels a { display: flex; align-items: center; gap: 16px; padding: 16px 18px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--ink); background: var(--card); }
  .channels a:hover { border-color: var(--brand); color: var(--ink); }
  .channels .icon-badge { margin: 0; flex: none; }
  .channels small { display: block; color: var(--muted); font-size: 0.82rem; }
  .channels strong { font-family: var(--font-display); }
  .info p { display: flex; gap: 12px; }
  .info :global(svg) { width: 20px; height: 20px; color: var(--brand-text); flex: none; margin-top: 4px; }
  .info strong { color: var(--ink); }
  .map { margin: 20px 0 0; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); }
  .map iframe { display: block; width: 100%; height: 280px; border: 0; }
  :global([data-theme='dark']) .map iframe { filter: invert(0.9) hue-rotate(180deg) saturate(0.8); }
  .map figcaption { display: flex; align-items: center; gap: 10px; padding: 12px 16px; font-size: 0.9rem; color: var(--muted); }
  .map figcaption :global(svg) { width: 18px; height: 18px; color: var(--brand-text); flex: none; }
</style>
