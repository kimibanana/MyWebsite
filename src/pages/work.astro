---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
---
<Base
  title="Results | Medical Marketing Case Studies | Web Frontier"
  description="See how Web Frontier helps clinics and practices get more patients, calls and bookings with SEO, websites, Google Ads and LSA."
>
  <PageHero
    eyebrow="Results"
    title="Results we’re proud of"
    lead="Every engagement starts with a business problem and ends with a measurable result: more new patients, more bookings, lower cost per patient."
    crumbs={[{ label: 'Results' }]}
  />
  <section class="section">
    <div class="wrap"><CaseStudies /></div>
  </section>
  <section class="section section--surface">
    <div class="wrap">
      <div class="head head--center"><span class="eyebrow">Client reviews</span><h2>In their words</h2></div>
      <Testimonials />
    </div>
  </section>
  <CtaBand title="Want results like these?" text="Start with a free audit. We’ll show you exactly where your biggest opportunities are." />
</Base>
