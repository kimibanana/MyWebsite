---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { promises } from '../data/content';
import { site } from '../data/site';

const values = [
  { icon: 'chart', title: 'Results over activity', body: 'We report on leads and revenue, not hours logged or tasks ticked off.' },
  { icon: 'heart', title: 'Plain language', body: 'No jargon. If we can’t explain it simply, we shouldn’t be charging for it.' },
  { icon: 'users', title: 'Real partnership', body: 'You talk directly to the people doing the work, and we answer within a business day.' },
  { icon: 'zap', title: 'Speed and quality', body: 'Fast websites, fast replies, and work done right the first time.' },
];
const team = [
  {
    name: site.founder.name,
    initials: site.founder.initials,
    role: site.founder.role,
    // TODO: add photo, certifications and a personal touch
    bio: 'Kimberly has spent more than a decade in SEO, web design and paid search, and founded Web Frontier to give clinics and practices marketing they can see: clear scope, real deliverables, and results measured in patients.',
  },
  {
    name: 'Oliver Vincent Fernandico',
    initials: 'OF',
    role: 'Mlemeloper',
    bio: 'Oliver is our web developer and all-around IT lead. He builds fast, accessible clinic websites, sets up online booking, forms, analytics and call tracking, and keeps hosting, domains, email and security running smoothly behind the scenes. If it has a login, a server or a bug, Oliver is the one who fixes it.',
  },
];
---
<Base
  title="About Web Frontier | Medical Marketing Agency with 10+ Years Experience"
  description="Web Frontier is a medical marketing agency with 10+ years of SEO, web and ads experience, serving clinics, hospitals and practices in the Philippines and worldwide."
>
  <PageHero
    eyebrow="About Web Frontier"
    title="A medical marketing agency built on a decade of fundamentals"
    lead="We’re a team of SEO specialists, designers and ads managers with 10+ years in the industry, based in the Philippines and working only with healthcare."
    crumbs={[{ label: 'About' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="prose reveal">
        <span class="eyebrow">Our story</span>
        <h2>Why we started Web Frontier</h2>
        <!-- TODO: replace with the founder's real story -->
        <p>Over more than a decade in SEO, web design and paid search, we kept meeting the same frustrated practice owners. They had paid agencies every month for SEO they couldn’t see, websites that never booked a patient, and ads that broke healthcare policies.</p>
        <p>Web Frontier was built to be the opposite. Instead of open-ended retainers, we work in 30-day sprints: a written scope, a fixed price, and a report of exactly what was delivered and what it achieved.</p>
        <p>Today we work only with healthcare: dental, aesthetic and medical clinics, hospitals and specialist practices, in the Philippines and around the world. Focusing on one industry means we already know your patients, your rules and your competitors, and we treat every client’s budget like our own.</p>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Our team</span><h2>The people doing the work</h2></div>
      <div class="team">
        {team.map((m) => (
          <article class="member card reveal">
            <div class="member__photo" aria-hidden="true">{m.initials}</div>
            <div>
              <h3>{m.name}</h3>
              <p class="member__role">{m.role}</p>
              <p>{m.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Our values</span><h2>What we stand for</h2></div>
      <div class="grid grid-4">
        {values.map((v) => (
          <div class="card reveal"><div class="icon-badge"><Icon name={v.icon} /></div><h3>{v.title}</h3><p>{v.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Our promises</span><h2>What every client gets</h2></div>
      <div class="grid grid-4">
        {promises.map((p) => (
          <div class="card reveal"><div class="icon-badge"><Icon name={p.icon} /></div><h3>{p.title}</h3><p>{p.body}</p></div>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title="Let’s talk about your goals" />
</Base>

<style>
  .team { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 20px; }
  .member { display: flex; gap: 22px; align-items: flex-start; }
  .member h3 { margin-bottom: 2px; }
  .member p:last-child { margin: 0; }
  .member__photo { flex: none; width: 88px; height: 88px; border-radius: var(--radius-lg); display: grid; place-items: center; background: var(--ink); color: #fff; font-family: var(--font-display); font-size: 1.9rem; font-weight: 700; }
  :global([data-theme='dark']) .member__photo { background: var(--brand); }
  .member__role { color: var(--brand-text); font-weight: 600; margin-bottom: 10px; }
  @media (max-width: 520px) { .member { flex-direction: column; } }
</style>
