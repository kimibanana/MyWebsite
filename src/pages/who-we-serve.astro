---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { specialties } from '../data/content';

const slug = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// What growth looks like in each specialty.
const detail: Record<string, { focus: string; wins: string[] }> = {
  'Hospitals & medical centers': { focus: 'Grow departments and specialty centers with search visibility for every service and doctor.', wins: ['Department and doctor profile pages', 'Google Maps for every branch', 'Campaigns for high-value services'] },
  'Diagnostics & laboratories': { focus: 'Be the lab or imaging center patients and doctors find first, with clear tests, prices and branches.', wins: ['Test and package pages', 'Branch-level local SEO', 'Online booking and home-service requests'] },
  'Fertility & IVF': { focus: 'Reach couples early in a long, emotional research journey with sensitive, trustworthy content.', wins: ['Treatment and success-rate pages', 'Consultation funnels', 'Privacy-first tracking'] },
  'Weight loss & wellness': { focus: 'Promote programs and treatments within strict health-claim and ad-platform rules.', wins: ['Compliant program pages', 'Policy-safe Google Ads', 'Consultation booking'] },
  'Eye care & ophthalmology': { focus: 'Fill the schedule for eye exams, LASIK, cataract and specialist care.', wins: ['Procedure pages', 'Map Pack for every clinic', 'Procedure campaigns'] },
  'Dental & orthodontics': { focus: 'Fill the schedule with new patients and grow high-value treatments like implants, Invisalign and cosmetic dentistry.', wins: ['“Dentist near me” Map Pack rankings', 'Implant and Invisalign landing pages', 'Emergency dental ads'] },
  'Aesthetic & med spa clinics': { focus: 'Book more consultations for injectables, lasers and body treatments while staying inside ad platform policies.', wins: ['Treatment pages with before-and-after galleries', 'Policy-compliant Google Ads', 'Online consultation booking'] },
  'Dermatology': { focus: 'Attract both medical and cosmetic patients with content patients and Google trust.', wins: ['Condition pages reviewed by your dermatologists', 'Cosmetic treatment campaigns', 'Multi-provider profiles'] },
  'Plastic & cosmetic surgery': { focus: 'Reach high-intent patients researching procedures and turn them into consultations.', wins: ['Procedure pages and galleries', 'Surgeon credential and review signals', 'Consultation funnels'] },
  'Chiropractic': { focus: 'Become the go-to chiropractor in your area for back pain, injuries and wellness care.', wins: ['Local SEO for each condition', 'Local Services Ads where eligible', 'New-patient offer pages'] },
  'Physical therapy & rehab': { focus: 'Compete with national chains for local patients and physician referrals.', wins: ['Location and condition pages', 'Review generation across clinics', 'Direct-access patient campaigns'] },
  'Primary care & family clinics': { focus: 'Be the first clinic people find when they need care today.', wins: ['Map Pack visibility for every location', 'Wait-time and hours accuracy', 'Service and insurance pages'] },
  'Mental health & therapy': { focus: 'Help people find the right therapist with sensitive, privacy-first marketing.', wins: ['Specialty and modality pages', 'Privacy-conscious tracking', 'Therapist profile optimization'] },
};
---
<Base
  title="Healthcare Specialties We Serve | Philippines & Worldwide | Web Frontier"
  description="Web Frontier markets dental, aesthetic, dermatology, plastic surgery, hospitals, diagnostics, fertility and other healthcare providers in the Philippines and worldwide."
>
  <PageHero
    eyebrow="Specialties"
    title="Built for every corner of healthcare"
    lead="We work only with healthcare providers, from single-doctor clinics to hospitals, in the Philippines and around the world."
    crumbs={[{ label: 'Specialties' }]}
  >
    <nav class="jump" aria-label="Jump to">
      <a href="#specialties">Specialties</a><a href="#locations">Philippines & worldwide</a>
    </nav>
  </PageHero>

  <section class="section" id="specialties">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Medical specialties</span><h2>Marketing for every kind of practice</h2></div>
      <div class="grid grid-2">
        {specialties.map((s) => (
          <article class="card spec reveal" id={slug(s.name)}>
            <div class="spec__head"><span class="icon-badge"><Icon name={s.icon} /></span><h3>{s.name}</h3></div>
            <p>{detail[s.name]?.focus}</p>
            <ul class="checks">{detail[s.name]?.wins.map((w) => <li>{w}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--surface" id="locations">
    <div class="wrap locals">
      <div class="reveal">
        <span class="eyebrow">Philippines & worldwide</span>
        <h2>Local expertise at home, global reach abroad</h2>
        <p class="lead">In the Philippines, we help clinics and hospitals win Google Maps in their city and follow FDA Philippines and DOH rules on health advertising. Abroad, we work in your time zone and follow your country’s rules, from HIPAA in the US to Ahpra in Australia.</p>
        <ul class="checks">
          <li>Google Maps and local SEO for every clinic location</li>
          <li>Treatment pages written for how patients search in your market</li>
          <li>Google Ads built to pass healthcare policies</li>
          <li>Privacy-safe tracking and booking</li>
        </ul>
      </div>
      <div class="card reveal">
        <h3>Philippines</h3>
        <ul class="chips">{site.phCities.map((c) => <li>{c}</li>)}</ul>
        <h3>International</h3>
        <ul class="chips">{site.markets.filter((m) => m !== 'Philippines').map((m) => <li>{m}</li>)}</ul>
        <a class="btn btn--primary btn--block" href="/free-audit">Get a free growth audit <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CtaBand title="Don’t see your specialty or industry?" text="If you serve customers in a local area, our process works for you. Get a free growth audit and we’ll show you where to start." />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a { padding: 8px 16px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  .jump a:hover { border-color: var(--brand); }
  .spec { scroll-margin-top: 90px; }
  .spec__head { display: flex; align-items: center; gap: 14px; margin-bottom: 8px; }
  .spec__head .icon-badge { margin: 0; flex: none; }
  .spec__head h3 { margin: 0; }
  .spec .checks { font-size: 0.95rem; }
  #specialties, #locations { scroll-margin-top: 70px; }
  .locals { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  @media (max-width: 860px) { .locals { grid-template-columns: 1fr; } }
  .locals .card h3 { font-size: 1.05rem; }
  .chips { list-style: none; margin: 0 0 24px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { padding: 8px 14px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-weight: 600; font-size: 0.92rem; color: var(--ink); }
</style>
