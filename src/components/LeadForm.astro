---
import { site } from '../data/site';
import { services } from '../data/services';

interface Props {
  id?: string;
  title?: string;
  button?: string;
  compact?: boolean;
  formName?: string;
}
const {
  id = 'lead-form',
  title,
  button = 'Get my free growth audit',
  compact = false,
  formName = 'free-audit',
} = Astro.props;

// Netlify Forms by default; a third-party endpoint if one is configured.
const action = site.formEndpoint || '/thank-you';
---
<form
  id={id}
  class="lead"
  name={formName}
  method="POST"
  action={action}
  data-netlify={site.formEndpoint ? undefined : 'true'}
  netlify-honeypot="company_url"
>
  {title && <h3 class="lead__title">{title}</h3>}
  <input type="hidden" name="form-name" value={formName} />
  <p class="sr-only"><label>Leave this empty <input name="company_url" tabindex="-1" autocomplete="off" /></label></p>

  <div class="field">
    <label for={`${id}-name`}>Your name</label>
    <input id={`${id}-name`} name="name" autocomplete="name" required />
  </div>
  <div class="lead__row">
    <div class="field">
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>Phone <span class="opt">(optional)</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" />
    </div>
  </div>
  <div class="lead__row">
    <div class="field">
      <label for={`${id}-site`}>Website <span class="opt">(if you have one)</span></label>
      <input id={`${id}-site`} name="website" type="text" inputmode="url" placeholder="yourbusiness.com" />
    </div>
    <div class="field">
      <label for={`${id}-country`}>Country</label>
      <select id={`${id}-country`} name="country">
        {site.markets.map((m) => <option>{m}</option>)}
        <option>Other</option>
      </select>
    </div>
  </div>
  <div class="field">
    <label for={`${id}-need`}>What do you need help with?</label>
    <select id={`${id}-need`} name="service">
      <option>Not sure yet, please advise</option>
      {services.map((s) => <option>{s.name}</option>)}
    </select>
  </div>
  {!compact && (
    <div class="field">
      <label for={`${id}-msg`}>Anything else? <span class="opt">(optional)</span></label>
      <textarea id={`${id}-msg`} name="message" placeholder="Your goals, timeline, or budget"></textarea>
    </div>
  )}
  <button class="btn btn--primary btn--block" type="submit">{button}</button>
  <p class="form-note">We reply within 1 business day, in your time zone. Please don’t include any patient or medical information.</p>
</form>

<style>
  .lead { background: var(--card); border-radius: var(--radius-lg); padding: clamp(22px, 3vw, 32px); box-shadow: var(--shadow-lg); border: 1px solid var(--line); color: var(--ink-2); }
  .lead__title { margin-bottom: 18px; }
  .lead__row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
  .opt { font-weight: 400; color: var(--muted); }
  @media (max-width: 520px) { .lead__row { grid-template-columns: 1fr; } }
</style>
