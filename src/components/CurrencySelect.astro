---
import { currencies } from '../lib/price';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<label class:list={['cur', { 'cur--compact': compact }]}>
  <span class={compact ? 'sr-only' : ''}>Currency</span>
  <select class="cur__select" aria-label="Currency">
    {currencies.map((c) => <option value={c.code}>{c.label}</option>)}
  </select>
</label>

<style>
  .cur { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.93rem; color: var(--ink); }
  .cur select { font: inherit; font-weight: 600; padding: 8px 32px 8px 14px; border-radius: 999px; border: 1px solid var(--line); background-color: var(--card); color: var(--ink); cursor: pointer; }
  .cur--compact { color: inherit; }
  .cur--compact select { padding: 3px 24px 3px 10px; font-size: 0.8rem; background-color: transparent; color: inherit; }
</style>
