---
// Calm, slow crossfade of healthcare and healing photos.
// Photos are from Unsplash (free to use). Each slide has a soft gradient
// behind the photo, so it still looks right while an image loads.
const img = (id: string) => `https://images.unsplash.com/${id}?auto=format&fit=crop&w=1100&h=1300&q=70`;
const slides = [
  { src: img('photo-1631217868264-e5b90bb7e133'), alt: 'A smiling doctor talking with a patient in a clinic', caption: 'Care that listens', tint: '#cfe5df' },
  { src: img('photo-1519494026892-80bbd2d6fd0d'), alt: 'A modern hospital building', caption: 'Trusted places of care', tint: '#d6e4ea' },
  { src: img('photo-1542601906990-b4d3fb778b09'), alt: 'Hands holding a young plant growing in soil', caption: 'Growth, gently', tint: '#e3e7d2' },
  { src: img('photo-1584432810601-6c7f27d2362b'), alt: 'A healthcare worker with a stethoscope', caption: 'People who care', tint: '#dfe6ee' },
];
---
<div class="ss" data-slideshow>
  <div class="ss__frame">
    {slides.map((s, i) => (
      <figure class:list={['ss__slide', { 'is-active': i === 0 }]} style={`--tint:${s.tint}`} aria-hidden={i === 0 ? undefined : 'true'}>
        <img src={s.src} alt={s.alt} width="1100" height="1300" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" fetchpriority={i === 0 ? 'high' : undefined} />
        <figcaption>{s.caption}</figcaption>
      </figure>
    ))}
  </div>
  <div class="ss__controls">
    <div class="ss__dots" role="group" aria-label="Choose slide">
      {slides.map((s, i) => <button type="button" aria-label={`Show slide ${i + 1}: ${s.caption}`} aria-current={i === 0 ? 'true' : undefined} data-go={i}></button>)}
    </div>
    <button type="button" class="ss__pause" aria-label="Pause slideshow" data-pause>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="i-pause"><path d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor" /></svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="i-play"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.ss__slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: number | undefined;
    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.classList.toggle('is-active', k === i);
        if (k === i) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, k) => (k === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    const play = () => { stop(); timer = window.setInterval(() => show(i + 1), 6000); root.classList.remove('is-paused'); pause.setAttribute('aria-label', 'Pause slideshow'); };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.go)); if (timer) play(); }));
    pause.addEventListener('click', () => {
      if (timer) { stop(); root.classList.add('is-paused'); pause.setAttribute('aria-label', 'Play slideshow'); } else play();
    });
    // Load the remaining photos once the page is idle.
    slides.forEach((s) => s.querySelector('img')?.setAttribute('loading', 'eager'));
    if (reduced) { root.classList.add('is-paused'); pause.setAttribute('aria-label', 'Play slideshow'); } else play();
  });
</script>

<style>
  .ss { position: relative; }
  .ss__frame { position: relative; aspect-ratio: 5 / 6; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); background: var(--sage); }
  .ss__slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.4s ease; background: linear-gradient(160deg, var(--tint), #f5f7f2); }
  .ss__slide.is-active { opacity: 1; }
  :global([data-theme='dark']) .ss__slide { background: linear-gradient(160deg, #16343a, #0f2129); }
  .ss__slide img { display: block; width: 100%; height: 100%; object-fit: cover; color: transparent; font-size: 0; transform: scale(1.04); transition: transform 7s ease-out; }
  .ss__slide.is-active img { transform: scale(1); }
  .ss__slide::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, rgb(11 26 36 / 0.45)); }
  .ss figcaption { position: absolute; left: 22px; bottom: 20px; z-index: 1; color: #fff; font-family: var(--font-display); font-weight: 600; font-size: 1rem; }
  .ss__controls { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 16px; }
  .ss__dots { display: flex; gap: 8px; }
  .ss__dots button { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 6px; background: var(--line); cursor: pointer; transition: width .3s ease, background-color .3s ease; }
  .ss__dots button[aria-current='true'] { width: 26px; background: var(--brand); }
  .ss__pause { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line); background: var(--card); color: var(--muted); display: grid; place-items: center; cursor: pointer; }
  .ss__pause svg { width: 14px; height: 14px; }
  .ss__pause .i-play, .ss.is-paused .ss__pause .i-pause { display: none; }
  .ss.is-paused .ss__pause .i-play { display: block; }
  @media (prefers-reduced-motion: reduce) { .ss__slide, .ss__slide img { transition: none; } }
  @media (max-width: 960px) { .ss__frame { aspect-ratio: 4 / 3; } }
</style>
