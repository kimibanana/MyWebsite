---
interface Props {
  plan: { name: string; price: string; cadence: string; blurb: string; features: string[]; cta: string; featured: boolean };
}
const { plan } = Astro.props;
---
<article class:list={['pc', 'reveal', { 'pc--featured': plan.featured }]}>
  {plan.featured && <span class="pc__badge">Most popular</span>}
  <h3>{plan.name}</h3>
  <p class="pc__blurb">{plan.blurb}</p>
  <p class="pc__price"><span class="pc__from">Starts at</span><strong>{plan.price}</strong><span>{plan.cadence}</span></p>
  <ul class="checks">{plan.features.map((f) => <li>{f}</li>)}</ul>
  <a class:list={['btn', 'btn--block', plan.featured ? 'btn--primary' : 'btn--secondary']} href={`/contact?plan=${encodeURIComponent(plan.name)}`}>{plan.cta}</a>
</article>

<style>
  .pc { position: relative; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 32px 28px; display: flex; flex-direction: column; }
  .pc--featured { border: 2px solid var(--brand); box-shadow: var(--shadow-lg); }
  .pc__badge { position: absolute; top: -13px; left: 28px; background: var(--brand); color: #fff; font-size: 0.75rem; font-weight: 700; padding: 4px 12px; border-radius: 999px; letter-spacing: 0.03em; }
  .pc__blurb { color: var(--muted); font-size: 0.97rem; min-height: 3em; }
  .pc__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; margin-bottom: 22px; }
  .pc__from { width: 100%; font-size: 0.8rem; color: var(--muted); font-weight: 600; }
  .pc__price strong { font-family: var(--font-display); font-size: 2.3rem; color: var(--ink); letter-spacing: -0.03em; line-height: 1; }
  .pc__price span:last-child { color: var(--muted); }
  .pc .checks { margin-bottom: 28px; font-size: 0.97rem; }
  .pc .btn { margin-top: auto; }
</style>
