---
import { sprintCycle } from '../data/content';
---
<ol class="cycle">
  {sprintCycle.map((s, i) => (
    <li class="reveal">
      <span class="cycle__week">{s.week}</span>
      <h3><span class="cycle__n">{i + 1}</span>{s.title}</h3>
      <p>{s.body}</p>
    </li>
  ))}
</ol>

<style>
  .cycle { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; background: var(--card); }
  .cycle li { padding: 26px 24px; border-left: 1px solid var(--line); position: relative; }
  .cycle li:first-child { border-left: 0; }
  .cycle li:last-child { background: var(--brand-tint); }
  .cycle__week { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--brand-text); }
  .cycle h3 { display: flex; align-items: center; gap: 10px; margin: 8px 0 6px; }
  .cycle__n { width: 28px; height: 28px; border-radius: 50%; background: var(--brand); color: #fff; display: grid; place-items: center; font-size: 0.85rem; }
  .cycle p { margin: 0; font-size: 0.97rem; }
  @media (max-width: 760px) { .cycle { grid-template-columns: 1fr; } .cycle li { border-left: 0; border-top: 1px solid var(--line); } .cycle li:first-child { border-top: 0; } }
</style>
