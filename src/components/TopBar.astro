---
import Icon from './Icon.astro';
import CurrencySelect from './CurrencySelect.astro';
import { site } from '../data/site';
---
<div class="tb">
  <div class="wrap tb__in">
    <ul class="tb__contact">
      <li><a href={site.whatsapp} target="_blank" rel="noopener" aria-label={`WhatsApp ${site.whatsappDisplay}`}><Icon name="whatsapp" /><span>{site.whatsappDisplay}</span></a></li>
      {site.email && <li><a href={`mailto:${site.email}`} aria-label={`Email ${site.email}`}><Icon name="mail" /><span>{site.email}</span></a></li>}
      <li class="tb__hours"><Icon name="clock" /><span>{site.hours}</span></li>
    </ul>
    <div class="tb__right">
    <CurrencySelect compact />
    <ul class="tb__social" aria-label="Social media">
      {site.social.map((s) => (
        <li><a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}><Icon name={s.icon} /></a></li>
      ))}
    </ul>
    </div>
  </div>
</div>

<style>
  .tb { background: var(--surface); color: var(--muted); font-size: 0.84rem; border-bottom: 1px solid var(--line); }
  .tb__in { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 38px; }
  .tb ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; }
  .tb__contact { gap: 22px; }
  .tb__contact li, .tb__contact a { display: inline-flex; align-items: center; gap: 7px; }
  .tb a { color: var(--muted); text-decoration: none; }
  .tb a:hover { color: var(--brand-text); }
  .tb__contact :global(svg) { width: 14px; height: 14px; color: var(--brand-text); flex: none; }
  .tb__right { display: flex; align-items: center; gap: 10px; }
  .tb__social { gap: 2px; }
  .tb__social a { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; }
  .tb__social a:hover { background: var(--brand-tint); }
  .tb__social :global(svg) { width: 15px; height: 15px; }
  @media (max-width: 1100px) { .tb__hours { display: none !important; } }
  .tb__contact a, .tb__contact li { white-space: nowrap; }
  @media (max-width: 720px) {
    .tb__contact li:not(:first-child) { display: none; }
  }
  @media (max-width: 420px) { .tb__contact span { display: none; } .tb__contact li:nth-child(2) { display: inline-flex; } .tb__contact { gap: 0; } .tb__contact a { min-width: 44px; min-height: 44px; justify-content: center; } }
  /* Social links stay in the footer on phones, where there is room for full-size tap targets. */
  @media (max-width: 720px) { .tb .tb__social { display: none; } }
</style>
