---
// Placeholder wordmark until a final logo is supplied.
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <rect width="40" height="40" rx="11" fill="#0E7C7B" />
    <path d="M7 29l9.5-13 5 6.5 3.5-4.5L33 29" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
    <circle cx="27.5" cy="11" r="3.6" fill="#FF8A3D" />
  </svg>
  <span class="logo__text">Web<span>Frontier</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .logo--light { color: #fff; }
  .logo__mark { width: 38px; height: 38px; flex: none; }
  .logo__text { font-family: var(--font-display); font-weight: 800; font-size: 1.32rem; letter-spacing: -0.03em; line-height: 1; white-space: nowrap; }
  .logo__text span { color: var(--brand-text); margin-left: 0.22em; }
  .logo--light .logo__text span { color: #5fd3cf; }
</style>
