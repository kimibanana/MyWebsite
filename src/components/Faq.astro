---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details class="faq__item">
      <summary>{f.q}<span class="faq__icon"><Icon name="plus" /></span></summary>
      <p>{f.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { max-width: 820px; margin: 0 auto; display: grid; gap: 12px; }
  .faq__item { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 0 22px; }
  .faq__item[open] { border-color: var(--brand); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; align-items: center;
    padding: 20px 0; font-family: var(--font-display); font-weight: 700; font-size: 1.08rem; color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  .faq__icon { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--surface); display: grid; place-items: center; color: var(--brand-text); transition: transform .2s ease; }
  .faq__icon :global(svg) { width: 16px; height: 16px; }
  .faq__item[open] .faq__icon { transform: rotate(45deg); }
  .faq__item p { padding-bottom: 20px; margin: 0; }
  @media (prefers-reduced-motion: reduce) { .faq__icon { transition: none; } }
</style>
