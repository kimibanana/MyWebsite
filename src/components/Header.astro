---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { services } from '../data/services';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label={`${site.name} home`}><Logo /></a>

    <nav class="hdr__nav" id="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) =>
          item.href === '/services' ? (
            <li class="has-menu">
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              <div class="menu">
                {services.map((s) => (
                  <a href={`/services/${s.slug}`} class="menu__item">
                    <span class="menu__icon"><Icon name={s.icon} /></span>
                    <span><strong>{s.name}</strong><small>{s.short}</small></span>
                  </a>
                ))}
              </div>
            </li>
          ) : (
            <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ),
        )}
      </ul>
      <div class="hdr__mobile-cta">
        <a class="btn btn--primary btn--block" href="/free-audit">Get a free growth audit</a>
        <a class="btn btn--secondary btn--block" href={site.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp us</a>
      </div>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__phone" href={site.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" /><span>WhatsApp</span></a>
      <a class="btn btn--primary btn--sm" href="/free-audit">Free growth audit</a>
      <button class="hdr__toggle" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu">
        <Icon name="menu" class="i-open" /><Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.hdr__toggle');
  const hdr = document.querySelector('.hdr');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    hdr?.classList.toggle('is-open', !open);
    document.body.style.overflow = open ? '' : 'hidden';
  });
  const onScroll = () => hdr?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .hdr.is-scrolled { border-color: var(--line); box-shadow: 0 4px 20px rgb(15 23 42 / 0.05); }
  .hdr__in { display: flex; align-items: center; gap: 24px; min-height: 76px; }
  .hdr__logo { text-decoration: none; flex: none; }
  .hdr__nav { margin-left: auto; }
  .hdr__nav ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; }
  .hdr__nav > ul > li > a {
    display: block; padding: 10px 14px; border-radius: 10px;
    font-weight: 600; font-size: 0.98rem; color: var(--ink); text-decoration: none;
  }
  .hdr__nav > ul > li > a:hover, .hdr__nav a[aria-current='page'] { background: var(--surface); color: var(--ink); }
  .has-menu { position: relative; }
  .menu {
    position: absolute; top: 100%; left: -120px; width: 560px; padding: 12px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 4px;
    background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow-lg);
    opacity: 0; visibility: hidden; transform: translateY(6px);
    transition: opacity .15s ease, transform .15s ease, visibility .15s;
  }
  .has-menu:hover .menu, .has-menu:focus-within .menu { opacity: 1; visibility: visible; transform: none; }
  .menu__item { display: flex; gap: 12px; padding: 12px; border-radius: 12px; text-decoration: none; color: var(--ink); }
  .menu__item:hover { background: var(--surface); color: var(--ink); }
  .menu__item strong { display: block; font-size: 0.95rem; font-family: var(--font-display); }
  .menu__item small { display: block; font-size: 0.82rem; line-height: 1.4; color: var(--muted); margin-top: 2px; }
  .menu__icon { flex: none; width: 36px; height: 36px; border-radius: 10px; background: var(--brand-tint); color: var(--brand); display: grid; place-items: center; }
  .menu__icon :global(svg) { width: 18px; height: 18px; }
  .hdr__actions { display: flex; align-items: center; gap: 16px; }
  .hdr__phone { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--ink); text-decoration: none; font-size: 0.95rem; }
  .hdr__phone :global(svg) { width: 18px; height: 18px; color: var(--brand); }
  .hdr__toggle { display: none; background: none; border: 0; padding: 8px; color: var(--ink); cursor: pointer; }
  .hdr__toggle :global(svg) { width: 26px; height: 26px; }
  .hdr__toggle :global(.i-close) { display: none; }
  .hdr__mobile-cta { display: none; }

  @media (max-width: 1120px) { .hdr__phone span { display: none; } }
  @media (max-width: 960px) {
    .hdr__in { min-height: 66px; }
    .hdr__toggle { display: block; }
    .hdr__phone { display: none; }
    .hdr__actions { margin-left: auto; gap: 8px; }
    .hdr__nav {
      position: fixed; inset: 66px 0 0 0; background: #fff; padding: 20px var(--gutter) 32px;
      overflow-y: auto; display: none; margin: 0;
    }
    .hdr.is-open .hdr__nav { display: block; }
    .hdr.is-open :global(.i-open) { display: none; }
    .hdr.is-open :global(.i-close) { display: block; }
    .hdr__nav ul { flex-direction: column; gap: 0; }
    .hdr__nav > ul > li > a { padding: 14px 4px; font-size: 1.15rem; border-bottom: 1px solid var(--line); border-radius: 0; }
    .menu { position: static; width: auto; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; padding: 4px 0 8px; grid-template-columns: 1fr; }
    .menu__item small { display: none; }
    .menu__item { padding: 8px 4px; align-items: center; }
    .hdr__mobile-cta { display: grid; gap: 10px; margin-top: 24px; }
  }
  @media (max-width: 420px) { .hdr__actions .btn { display: none; } }
</style>
