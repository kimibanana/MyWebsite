---
import { discountLabel } from '../lib/price';
---
<div class="bt" role="group" aria-label="Billing term">
  <button type="button" data-term="monthly" aria-pressed="true">Month-to-month</button>
  <button type="button" data-term="annual" aria-pressed="false">12-month partnership <span class="bt__save">Save {discountLabel}</span></button>
</div>

<script>
  // Every toggle on the page controls the closest [data-billing] wrapper.
  document.querySelectorAll<HTMLButtonElement>('.bt button').forEach((b) => {
    b.addEventListener('click', () => {
      const term = b.dataset.term!;
      const scope = b.closest<HTMLElement>('[data-billing]');
      if (scope) scope.dataset.billing = term;
      document.querySelectorAll<HTMLButtonElement>('.bt button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.term === term)));
    });
  });
</script>

<style>
  .bt { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); }
  .bt button { border: 0; background: none; font: inherit; font-weight: 600; font-size: 0.93rem; color: var(--muted); padding: 9px 16px; border-radius: 999px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
  .bt button[aria-pressed='true'] { background: var(--brand); color: #fff; }
  .bt__save { font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; background: var(--accent); color: #1b1206; }
</style>
