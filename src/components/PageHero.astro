---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
}
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
const schema = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ label: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        ...(c.href ? { item: new URL(c.href, Astro.site).href } : {}),
      })),
    }
  : null;
---
<section class="ph">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {crumbs.map((c) => (
          <>
            <span aria-hidden="true">/</span>
            {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
          </>
        ))}
      </nav>
    )}
    <div class="ph__grid">
      <div>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
      <slot name="aside" />
    </div>
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</section>

<style>
  .ph { padding: clamp(36px, 5vw, 64px) 0 clamp(48px, 6vw, 80px);
    background: radial-gradient(60% 90% at 100% 0%, var(--brand-tint) 0%, transparent 70%), var(--surface); }
  .ph h1 { font-size: clamp(2rem, 4.4vw, 3.1rem); max-width: 20ch; }
  .ph__grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center; }
  .ph__grid:has(> :nth-child(2)) { grid-template-columns: 1.15fr 0.85fr; }
  @media (max-width: 960px) { .ph__grid:has(> :nth-child(2)) { grid-template-columns: 1fr; } }
</style>
